<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="using:CamperManagement.ViewModels"
             x:Class="CamperManagement.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Strom- und Wasserpreise" FontSize="24" />
            <TextBlock Text="Nach dem Speichern gelten diese Faktoren sofort für neue Rechnungen auf allen Geräten – unabhängig vom Abrechnungsjahr. Bestehende Rechnungen behalten ihren gespeicherten Faktor."
                       TextWrapping="Wrap" />
            <TextBlock Text="Strom – Euro je kWh" />
            <TextBox Text="{Binding StromText}" IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="Wasser – Euro je m³" />
            <TextBox Text="{Binding WasserText}" IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Speichern" Command="{Binding SaveCommand}" />
                <Button Content="Neu laden" Command="{Binding LoadCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
