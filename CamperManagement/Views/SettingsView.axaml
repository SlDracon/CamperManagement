<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:views="using:CamperManagement.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:vm="using:CamperManagement.ViewModels"
             x:Class="CamperManagement.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource FormPadding}" Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
        <views:OperationStatus />
            <TextBlock Text="Strom- und Wasserpreise" FontSize="24" />
            <TextBlock Text="Nach dem Speichern gelten diese Faktoren sofort für neue Rechnungen auf allen Geräten – unabhängig vom Abrechnungsjahr. Bestehende Rechnungen behalten ihren gespeicherten Faktor."
                       TextWrapping="Wrap" />
            <TextBlock Text="Strom – Euro je kWh" />
            <TextBox AutomationProperties.Name="Strom – Euro je kWh" Text="{Binding StromText}" IsEnabled="{Binding CanEdit}" />
            <TextBlock Text="Wasser – Euro je m³" />
            <TextBox AutomationProperties.Name="Wasser – Euro je m³" Text="{Binding WasserText}" IsEnabled="{Binding CanEdit}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Speichern" Command="{Binding SaveCommand}" />
                <Button Content="Neu laden" Command="{Binding LoadCommand}" />
            </StackPanel>
            <Button Content="Datenbankverbindung …" Command="{Binding ConnectionCommand}" IsVisible="{Binding CanConfigureConnection}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
