<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:views="using:CamperManagement.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="using:CamperManagement.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CamperManagement.Views.EditCamperView"
        x:DataType="vm:EditCamperViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource FormPadding}">
        <views:OperationStatus />
        <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="Platznummer" />
        <TextBox AutomationProperties.Name="Platznummer" Text="{Binding Platznr}" IsReadOnly="True" />

        <TextBlock Text="Anrede" Margin="0,10,0,0" />
        <ComboBox AutomationProperties.Name="Anrede" IsEnabled="{Binding !IsBusy}" ItemsSource="{Binding Anreden}" SelectedItem="{Binding SelectedAnrede}" />

        <TextBlock Text="Vorname" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="Vorname" IsEnabled="{Binding !IsBusy}" Text="{Binding Vorname}" />

        <TextBlock Text="Nachname" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="Nachname" IsEnabled="{Binding !IsBusy}" Text="{Binding Nachname}" />

        <TextBlock Text="Straße" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="Straße" IsEnabled="{Binding !IsBusy}" Text="{Binding Straße}" />

        <TextBlock Text="PLZ" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="PLZ" IsEnabled="{Binding !IsBusy}" Text="{Binding Plz}" />

        <TextBlock Text="Ort" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="Ort" IsEnabled="{Binding !IsBusy}" Text="{Binding Ort}" />

        <TextBlock Text="E-Mail" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="E-Mail" IsEnabled="{Binding !IsBusy}" Text="{Binding Email}" />

        <TextBlock Text="Vertragskosten" Margin="0,10,0,0" />
        <TextBox AutomationProperties.Name="Vertragskosten" IsEnabled="{Binding !IsBusy}" Text="{Binding VertragskostenText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Speichern" Command="{Binding SaveCommand}" />
            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
